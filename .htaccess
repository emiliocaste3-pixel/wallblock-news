# WallBlock News - Hostinger (Apache / LiteSpeed)
# Every block is wrapped in <IfModule> so a module that is not available is skipped instead of breaking the site.
# Tip: turn on "Force HTTPS" in hPanel (Websites > Security > SSL) instead of adding redirect rules here.

DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
  AddType application/json .json
  AddType image/x-icon .ico
  AddType application/manifest+json .webmanifest
</IfModule>

# Text compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/json application/javascript image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  # The page and the news data change often: always revalidate
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  # Media and fonts rarely change
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|content\.json|wb3\.css|wb3\.js|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=()"
</IfModule>
