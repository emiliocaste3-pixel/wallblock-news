# Only wallie.php must be reachable from the web. Keys, samples, counters and logs are private.
<FilesMatch "^(config\.php|config\.sample\.php|\.htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
